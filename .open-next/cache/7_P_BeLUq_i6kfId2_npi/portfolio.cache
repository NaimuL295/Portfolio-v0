{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/portfolio/layout,_N_T_/portfolio/page,_N_T_/portfolio"}},"html":"<!DOCTYPE html><!--7_P_BeLUq_i6kfId2_npi--><html lang=\"en\" data-theme=\"cupcake\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" href=\"https://i.ibb.co/ksmYbbdj/Screenshot-2025-08-13-192129.png\"/><link rel=\"preload\" as=\"image\" href=\"https://i.ibb.co/TDxYbFyJ/Screenshot-2025-08-13-192939.png\"/><link rel=\"preload\" as=\"image\" href=\"https://i.ibb.co/tMT1cnVq/Screenshot-2025-08-13-192729.png\"/><link rel=\"stylesheet\" href=\"/_next/static/css/0c4ac01287fd8734.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-0161bab2a1105295.js\"/><script src=\"/_next/static/chunks/4bd1b696-c023c6e3521b1417.js\" async=\"\"></script><script src=\"/_next/static/chunks/255-87552e6e05b8e3aa.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-95f2968bdd834508.js\" async=\"\"></script><script src=\"/_next/static/chunks/725-b31d5528f426e245.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-3fded6c4e4d4c584.js\" async=\"\"></script><script src=\"/_next/static/chunks/619-ba102abea3e3d0e4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/not-found-f8d5b7643e7dd560.js\" async=\"\"></script><script src=\"/_next/static/chunks/215-3720c0eee8a017e3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/portfolio/page-00bf04525b87d495.js\" async=\"\"></script><title>Naimul Hasan - MERN Stack Developer</title><meta name=\"description\" content=\"Professional portfolio showcasing MERN stack development,  and full-stack services. Available for freelance and full-time opportunities.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__className_528a31\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"sticky top-0 z-40 \"><nav class=\"sticky top-0 z-40   text-white shadow-lg\"><div class=\"max-w-7xl mx-auto flex justify-between items-center px-6 py-4\"><div class=\"flex items-center gap-3\"><span class=\"text-2xl font-bold tracking-wide\">Naimul</span></div><ul class=\"hidden lg:flex gap-10\"><li><a class=\"cursor-pointer hover:text-cyan-400 transition text-lg\">Home</a></li><li><a class=\"cursor-pointer hover:text-cyan-400 transition text-lg\">About</a></li><li><a class=\"cursor-pointer hover:text-cyan-400 transition text-lg\">Projects</a></li><li><a class=\"cursor-pointer hover:text-cyan-400 transition text-lg\">Contact</a></li></ul><div class=\"hidden lg:block\"><a href=\"/images/compressed.pdf\" download=\"/images/compressed.pdf\" class=\"inline-block text-sm px-6 py-3 rounded-lg text-white       hover:shadow-lg hover:shadow-cyan-400/20      transition\">Resume</a></div><div class=\"lg:hidden\"><button aria-label=\"Open Menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" class=\"h-7 w-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></nav>   </div><div class=\"min-h-[calc(100vh-300px)]\">  <div class=\"h-full\" style=\"transform:translateY(-200vh)\"><div class=\"h-[600vh]\"><div class=\"h-[calc(100vh-6rem)] flex items-center justify-center text-8xl text-center\">My Works</div><div class=\"sticky top-0 flex h-screen gap-4 items-center overflow-hidden\"><div class=\"flex\" style=\"transform:none\"><div class=\"h-98 w-2xl flex items-center justify-center \"></div><div class=\"flex overflow-x-auto gap-6 p-4\"><div class=\"min-w-[600px] bg-gray-800 p-4 rounded-lg text-white shadow-lg\"><img src=\"https://i.ibb.co/ksmYbbdj/Screenshot-2025-08-13-192129.png\" alt=\"Social-Events-Platform\" class=\"w-full lg:h-[300px] h-48 object-cover rounded\"/><h3 class=\"mt-4 text-2xl font-bold\">Social-Events-Platform</h3><p class=\"text-gray-400 mt-2\">A modern event management platform that allows users to create, join, and explore local or online events. Built with a responsive UI and real-time event updates to enhance community engagement.</p><ul class=\"mt-3 list-disc list-inside text-gray-300 text-sm\"><li>Real-Time Event Radar - See parties and meetups near you as they happen (no more FOMO!)</li><li>1-Click RSVP - Secure your spot faster than you can say &#x27;I&#x27;m in!&#x27;</li><li> Social Buzz Feed - Share moments and connect with other attendees before the event</li></ul><div class=\"flex flex-wrap gap-2 mt-3\"><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->React</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Node.js</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Express</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->MongoDB</li></span></div><div class=\"flex gap-3 mt-4\"><a target=\"_blank\" href=\"https://social-event.netlify.app/\"><button class=\"px-4 py-2 bg-white text-black rounded hover:bg-gray-200 transition\">Live Demo</button></a><a target=\"_blank\" href=\"https://github.com/NaimuL295/Social-Events-Platform\"><button class=\"px-4 py-2 bg-transparent border border-white text-white rounded hover:bg-white hover:text-black transition\">GitHub</button></a></div></div><div class=\"min-w-[600px] bg-gray-800 p-4 rounded-lg text-white shadow-lg\"><img src=\"https://i.ibb.co/TDxYbFyJ/Screenshot-2025-08-13-192939.png\" alt=\"Freelance-Task\" class=\"w-full lg:h-[300px] h-48 object-cover rounded\"/><h3 class=\"mt-4 text-2xl font-bold\">Freelance-Task</h3><p class=\"text-gray-400 mt-2\">A freelance marketplace that connects clients with freelancers. Features job posting, bidding, and task tracking to ensure smooth collaboration between both parties.</p><ul class=\"mt-3 list-disc list-inside text-gray-300 text-sm\"><li>Post and manage freelance jobs</li><li>Bid and track project progress</li><li>User profile creation and portfolio display</li></ul><div class=\"flex flex-wrap gap-2 mt-3\"><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->React</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Tailwind CSS</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Express.js</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->jwt</li></span></div><div class=\"flex gap-3 mt-4\"><a target=\"_blank\" href=\"https://freelance-task-2323.netlify.app/\"><button class=\"px-4 py-2 bg-white text-black rounded hover:bg-gray-200 transition\">Live Demo</button></a><a target=\"_blank\" href=\"https://github.com/NaimuL295/Freelance-Task-client-site\"><button class=\"px-4 py-2 bg-transparent border border-white text-white rounded hover:bg-white hover:text-black transition\">GitHub</button></a></div></div><div class=\"min-w-[600px] bg-gray-800 p-4 rounded-lg text-white shadow-lg\"><img src=\"https://i.ibb.co/tMT1cnVq/Screenshot-2025-08-13-192729.png\" alt=\"Forum-Platform\" class=\"w-full lg:h-[300px] h-48 object-cover rounded\"/><h3 class=\"mt-4 text-2xl font-bold\">Forum-Platform</h3><p class=\"text-gray-400 mt-2\">A community-driven blogging and discussion platform where users can share articles, comment, and interact within topic-specific categories.</p><ul class=\"mt-3 list-disc list-inside text-gray-300 text-sm\"><li>Clean, User-Friendly Interface</li><li>The forum has a minimalist design with intuitive navigation, making it easy for users to browse threads, post content, and engage in discussions without clutter.</li><li>Markdown Support</li><li>The platform supports Markdown formatting, allowing users to create well-structured posts with headings, lists, code blocks, and other styling options for better readability.</li><li>Responsive &amp; Fast Performance</li><li>Built with modern web technologies (likely Svelte/SvelteKit), the forum loads quickly and works seamlessly across devices, from desktops to mobile phones.</li></ul><div class=\"flex flex-wrap gap-2 mt-3\"><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->React</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Firebase</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Tailwind CSS</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Express.js</li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->Firebase </li></span><span class=\"btn  px-2 py-1 text-xs bg-gray-700 rounded\"><li> <!-- -->stripe</li></span></div><div class=\"flex gap-3 mt-4\"><a target=\"_blank\" href=\"https://s-forum-b.netlify.app/\"><button class=\"px-4 py-2 bg-white text-black rounded hover:bg-gray-200 transition\">Live Demo</button></a><a target=\"_blank\" href=\"https://github.com/NaimuL295/Forum-Client--site\"><button class=\"px-4 py-2 bg-transparent border border-white text-white rounded hover:bg-white hover:text-black transition\">GitHub</button></a></div></div></div></div></div></div><div class=\"h-screen flex flex-col gap-16 items-center justify-center text-center\"><h1 class=\"text-8xl\">Do you have a project?</h1><div class=\"relative\"><svg viewBox=\"0 0 300 300\" class=\"w-64 h-64 md:w-[500px] md:h-[500px]   lg:w-[900px] lg:h-[900px]\"><defs><path id=\"circlePath\" d=\"M 150, 150 m -60, 0 a 60,60 0 0,1 120,0 a 60,60 0 0,1 -120,0 \"></path></defs><text fill=\"#000\"><textPath xlink:href=\"#circlePath\" class=\"text-xl\" startOffset=\"50%\" text-anchor=\"middle\">Front-end Developer</textPath></text></svg><a class=\"w-16 h-16 md:w-28 md:h-28 absolute top-0 left-0 right-0 bottom-0 m-auto bg-black text-white rounded-full flex items-center justify-center\" href=\"/contact\">Hire Me</a></div></div></div><!--$--><!--/$--></div><footer class=\"text-center py-6  text-gray-300\">© <!-- -->2026<!-- -->  Designed by Naimul.</footer><script src=\"/_next/static/chunks/webpack-0161bab2a1105295.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[7877,[\\\"725\\\",\\\"static/chunks/725-b31d5528f426e245.js\\\",\\\"177\\\",\\\"static/chunks/app/layout-3fded6c4e4d4c584.js\\\"],\\\"default\\\"]\\n3:I[9766,[],\\\"\\\"]\\n4:I[8924,[],\\\"\\\"]\\n5:I[2619,[\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"345\\\",\\\"static/chunks/app/not-found-f8d5b7643e7dd560.js\\\"],\\\"\\\"]\\n6:I[1959,[],\\\"ClientPageRoot\\\"]\\n7:I[7272,[\\\"215\\\",\\\"static/chunks/215-3720c0eee8a017e3.js\\\",\\\"619\\\",\\\"static/chunks/619-ba102abea3e3d0e4.js\\\",\\\"281\\\",\\\"static/chunks/app/portfolio/page-00bf04525b87d495.js\\\"],\\\"default\\\"]\\na:I[4431,[],\\\"OutletBoundary\\\"]\\nc:I[5278,[],\\\"AsyncMetadataOutlet\\\"]\\ne:I[4431,[],\\\"ViewportBoundary\\\"]\\n10:I[4431,[],\\\"MetadataBoundary\\\"]\\n11:\\\"$Sreact.suspense\\\"\\n13:I[7150,[],\\\"\\\"]\\n:HL[\\\"/_next/static/css/0c4ac01287fd8734.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"7_P_BeLUq_i6kfId2_npi\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"portfolio\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"portfolio\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/0c4ac01287fd8734.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"data-theme\\\"